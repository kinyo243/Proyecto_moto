# -------------------------------------------------------------
# Configuración General del Proyecto
# -------------------------------------------------------------
PROJECT_NAME="Taller Automotriz y Motos API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# -------------------------------------------------------------
# Base de Datos PostgreSQL
# -------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="taller_db"

# Opcional: URL directa de conexión (si se define, tiene precedencia)
# DATABASE_URL="postgresql+psycopg2://postgres:postgres_password@localhost:5432/taller_db"

# -------------------------------------------------------------
# CORS (Orígenes permitidos en JSON)
# -------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

